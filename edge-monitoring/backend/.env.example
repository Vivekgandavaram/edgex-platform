# ── Server ────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Local dev: http://localhost:5173   Production: https://edgex.vigotech.in
APP_URL=http://localhost:5173
# Local dev: http://localhost:5000   Production: https://api.edgex.vigotech.in
API_BASE_URL=http://localhost:5000

# ── MongoDB ───────────────────────────────────────────
# Local:      mongodb://127.0.0.1:27017/edgex
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/edgex
MONGODB_URI=mongodb://127.0.0.1:27017/edgex

# ── Auth / JWT ────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# ── Google OAuth ──────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ── Email (transactional) ────────────────────────────
# Works with any SMTP provider (Resend, Postmark, SES, Mailgun, Gmail app password, etc.)
# Resend API keys also work via EMAIL_PASS or RESEND_API_KEY when using the SMTP transport.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USER=resend
EMAIL_PASS=your_smtp_password_or_api_key
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="EdgeX <support@vigotech.in>"
RESEND_FROM="EdgeX <support@vigotech.in>"

# ── Rate limiting ─────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_WRITE_MAX=120

# ── Seed (local dev only) ────────────────────────────
SEED_DEMO_SUPER_ADMIN_EMAIL=demo-admin@edgex.vigotech.in
SEED_DEMO_SUPER_ADMIN_PASSWORD=ChangeMe123!
